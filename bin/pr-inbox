#!/bin/sh
# Open the PR review inbox in the current terminal (works outside herdr panes too).
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export HERDR_PLUGIN_ID=pr-reviewer
export HERDR_PLUGIN_CONFIG_DIR="${HERDR_PLUGIN_CONFIG_DIR:-$HOME/.config/herdr/plugins/config/pr-reviewer}"
export HERDR_PLUGIN_STATE_DIR="${HERDR_PLUGIN_STATE_DIR:-$HOME/.local/state/herdr/plugins/pr-reviewer}"
exec node "$DIR/src/inbox.js" "$@"
